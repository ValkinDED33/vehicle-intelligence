PORT=3000
MONGO_URI=mongodb://localhost:27017/avto_platform
JWT_SECRET=change_me_before_prod
JWT_EXPIRES_IN=7d

# Этап 1: External Data Gateway для VIN — заполняется, когда выбран провайдер (см. открытые вопросы в ТЗ)
VIN_PROVIDER_URL=
VIN_PROVIDER_API_KEY=

# Этап 3: Telegram-бот
TELEGRAM_BOT_TOKEN=

# Этап 4: AI Runtime — провайдер не выбран окончательно (см. открытые вопросы в ТЗ)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Этап 5: Proactive Brain — провайдер погоды не выбран
WEATHER_PROVIDER_URL=
