# Application
PORT=3000
# Comma-separated list of allowed CORS origins.
# Default (when empty): localhost dev origins + https://vehicle-intelligence-nu.vercel.app
CORS_ORIGINS=

# Database — Neon PostgreSQL
DATABASE_URL=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI Gateway - backend only. No key is required for application startup.
# Google -> Groq (text only) -> optional NVIDIA -> optional Cloudflare -> OpenRouter.
# New recipients stay disabled until their data terms are reviewed for this app.
# Total budget for one gateway call, shared by all fallback attempts; max 60000.
AI_GATEWAY_TIMEOUT_MS=60000
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_DATA_POLICY_APPROVED=false
GOOGLE_TIMEOUT_MS=30000
GOOGLE_TEXT_MAX_TOKENS=2048
GOOGLE_ASSISTANT_MAX_TOKENS=2048
GOOGLE_VISION_MAX_TOKENS=4096

# Groq Free Tier has shared quotas; billing depends on the account's plan.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b
GROQ_ASSISTANT_MAX_TOKENS=2048
GROQ_TIMEOUT_MS=30000
GROQ_TEXT_MAX_TOKENS=1000
# GROQ_VISION_MAX_TOKENS is obsolete: GPT-OSS does not accept images.

# Optional NVIDIA prototype endpoint. Trial terms restrict personal data.
# Leave approval false unless an applicable API-service permission was reviewed.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_DATA_POLICY_APPROVED=false
NVIDIA_TIMEOUT_MS=30000
NVIDIA_MAX_TOKENS=4096

# Optional Workers AI. Use the existing Workers FREE plan, NOT Unified Billing.
# Account plan must be checked separately; a key cannot prove free-plan status.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_DATA_POLICY_APPROVED=false
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_TIMEOUT_MS=30000
CLOUDFLARE_MAX_TOKENS=4096

# Only verified $0 models are accepted. No paid fallback or credit purchase.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_DATA_POLICY_APPROVED=false
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_TEXT_MAX_TOKENS=2048
OPENROUTER_VISION_MAX_TOKENS=4096
# Optional emergency route: set only to openrouter/free; empty disables it.
OPENROUTER_EMERGENCY_MODEL=

# Independent vehicle artwork only, NOT used by the assistant/document gateway.
# Keep the real key in .env, not in frontend variables. This paid feature stays off.
OPENAI_API_KEY=
# Optional vehicle artwork generation. Setting the key alone does not authorize spend.
# Enable only after migration 0024 and an agreed generation budget.
VEHICLE_ARTWORK_ENABLED=false
# Global calls per UTC day (0 disables new requests); max 100.
VEHICLE_ARTWORK_DAILY_LIMIT=0
# Calls per owner per UTC day; max 5. Every attempt reserves quota, without auto-retry.
VEHICLE_ARTWORK_OWNER_DAILY_LIMIT=1

# Object storage — Backblaze B2 (S3-compatible)
B2_S3_ENDPOINT=
B2_S3_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# VIN / vehicle data provider — Vehicle Databases (Europe VIN Decode)
VIN_PROVIDER=vehicle-databases
VIN_PROVIDER_URL=https://api.vehicledatabases.com/europe-vin-decode/v2/{vin}
VIN_PROVIDER_API_KEY=

# VIN provider alternative — Vincario
VINCARIO_BASE_URL=https://api.vincario.com/3.2
VINCARIO_API_KEY=
VINCARIO_SECRET_KEY=

# Advanced VIN Decode (optional URL override; uses VIN_PROVIDER_API_KEY)
ADVANCED_VIN_PROVIDER_URL=

# Vehicle history provider (required for /external-reports history; uses VIN_PROVIDER_API_KEY)
VEHICLE_HISTORY_PROVIDER_URL=

# OneAutoAPI alternative reports
ONEAUTO_BASE_URL=https://sandbox.oneautoapi.com
ONEAUTO_API_KEY=


TELEGRAM_BOT_TOKEN=

TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_WEBHOOK_URL=https://vehicle-intelligence-o9mi.onrender.com/telegram/webhook

TELEGRAM_WEB_APP_URL=https://vehicle-intelligence-nu.vercel.app

TELEGRAM_VIN_LOOKUP_ENABLED=false

# Enable only on the production worker after applying migration 0019.
# Do not enable on previews or local processes connected to the production DB.
REMINDERS_WORKER_ENABLED=false
# Optional authenticated external scheduler; generate a random secret >=32 chars.
REMINDERS_CRON_SECRET=

# Frontend-only. Used when the site is opened outside Telegram and should point
# users back to the bot.
VITE_TELEGRAM_BOT_USERNAME=
