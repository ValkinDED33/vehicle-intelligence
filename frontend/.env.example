# Absolute URL of the vehicle-intelligence backend.
# Leave empty (or omit) for same-origin / Vite dev-proxy mode (localhost).
# For a cross-origin static deploy (e.g. Vercel) point it at the Render API:
VITE_API_URL=https://vehicle-intelligence-o9mi.onrender.com

# Bot username without @. Used by the auth screen outside Telegram.
VITE_TELEGRAM_BOT_USERNAME=
